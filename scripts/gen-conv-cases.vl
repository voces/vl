// Writes the fixtures for the float pmin/pmax, float-shape conversion and scalar
// saturating-truncation intrinsics: tests/cases/simd/float-pminmax.vl, float-convert.vl
// and tests/cases/numerics/trunc-sat.vl. The expected `@log` lines come from a model
// written from the wasm spec (pmin is `b < a ? b : a`, pmax `a < b ? b : a`, both an
// operand's bits unchanged; trunc_sat is 0 for NaN and clamps out-of-range), every value
// printed as its bit pattern. Re-run after changing the intrinsic table, from the root:
//
//     vl run scripts/gen-conv-cases.vl                 # write the cases
//     vl run scripts/gen-conv-cases.vl -- --verify     # also check every opcode
//
// `--out DIR` writes under DIR/simd and DIR/numerics instead of tests/cases.

import { IoError, readTextFile } from "std:fs"
import { programArgs } from "std:args"
import { toString } from "std:fmt"
import { join, startsWith } from "std:str"
import { Utf8Error } from "std:utf8"
import { hasFlag } from "./lib/common"
import {
  Leb,
  NameAlt,
  buildAndDisassemble,
  casesRoot,
  codeSection,
  demoteBits,
  fail,
  findNames,
  floatLt,
  intToF64Bits,
  leb,
  litI32,
  litI64,
  maskBits,
  pairsRepr,
  promoteBits,
  truncSatBits,
  wrapBits,
  writeOrDie,
} from "./lib/wasm-cases"

// ── the spec table: wasm name, prefix byte, sub-opcode, VL name ─────────────────────
// Written from the wasm 2.0 opcode list, not read from the compiler, so `--verify`
// compares two independent sources (and binaryen's decoder as the third).

type Row = { wasm: string, prefix: i32, sub: i32, vl: string }

function specTable(): Row[] {
  const rows: Row[] = [
    {
      wasm: "f32x4.pmin",
      prefix: 0xFD,
      sub: 0xEA,
      vl: "__pmin_f32x4__",
    },
    {
      wasm: "f32x4.pmax",
      prefix: 0xFD,
      sub: 0xEB,
      vl: "__pmax_f32x4__",
    },
    {
      wasm: "f64x2.pmin",
      prefix: 0xFD,
      sub: 0xF6,
      vl: "__pmin_f64x2__",
    },
    {
      wasm: "f64x2.pmax",
      prefix: 0xFD,
      sub: 0xF7,
      vl: "__pmax_f64x2__",
    },
    {
      wasm: "f32x4.demote_f64x2_zero",
      prefix: 0xFD,
      sub: 0x5E,
      vl: "__demote_f64x2_zero__",
    },
    {
      wasm: "f64x2.promote_low_f32x4",
      prefix: 0xFD,
      sub: 0x5F,
      vl: "__promote_low_f32x4__",
    },
    {
      wasm: "f64x2.convert_low_i32x4_s",
      prefix: 0xFD,
      sub: 0xFE,
      vl: "__convert_low_i32x4_s__",
    },
    {
      wasm: "f64x2.convert_low_i32x4_u",
      prefix: 0xFD,
      sub: 0xFF,
      vl: "__convert_low_i32x4_u__",
    },
  ]
  let sub = 0
  for dst in ["i32", "i64"] {
    for src in ["f32", "f64"] {
      for sign in ["s", "u"] {
        rows.push(
          {
            wasm: dst + ".trunc_sat_" + src + "_" + sign,
            prefix: 0xFC,
            sub: sub,
            vl: "__trunc_sat_\{src}_\{sign}_\{dst}__",
          },
        )
        sub = sub + 1
      }
    }
  }
  rows
}

// ── the inputs ──────────────────────────────────────────────────────────────────────

const F32_EDGES: i64[] = [
  0x00000000, 0x80000000, 0x3F000000, 0xBF000000, 0x3FF33333, 0xBFF33333,
  0x00000001, 0x7F7FFFFF, 0xFF7FFFFF, 0x7F800000, 0xFF800000, 0x7FC00000,
  0xFFC00000, 0x7FA00001, 0x4EFFFFFF, 0x4F000000, 0xCF000000, 0xCF000001,
  0x4F7FFFFF, 0x4F800000, 0xBF7FFFFF, 0x5EFFFFFF, 0x5F000000, 0xDF000000,
  0xDF000001, 0x5F7FFFFF, 0x5F800000,
]
const F64_EDGES: i64[] = [
  0x0000000000000000, 0x8000000000000000, 0x3FE0000000000000, 0xBFE0000000000000,
  0x0000000000000001, 0x7FEFFFFFFFFFFFFF, 0xFFEFFFFFFFFFFFFF, 0x7FF0000000000000,
  0xFFF0000000000000, 0x7FF8000000000000, 0xFFF8000000000000, 0x7FF4000000000001,
  0xBFECCCCCCCCCCCCD, // -0.9
  0xBFF0000000000000, // -1.0
  0x41DFFFFFFFF9999A, // 2147483647.9
  0x41E0000000000000, // 2147483648.0
  0xC1E00000001CCCCD, // -2147483648.9
  0xC1E0000000200000, // -2147483649.0
  0x41EFFFFFFFFCCCCD, // 4294967295.9
  0x41F0000000000000, // 4294967296.0
  0x43DFFFFFFFFFFFFF, // 9223372036854774784.0
  0x43E0000000000000, // 9223372036854775808.0
  0xC3E0000000000000, // -9223372036854775808.0
  0xC3E0000000000001, // -9223372036854777856.0
  0x43EFFFFFFFFFFFFF, // 18446744073709549568.0
  0x43F0000000000000, // 18446744073709551616.0
]

// Lane pairs (a, b) for pmin/pmax: every ordering of ±0, NaNs (signed, with payloads)
// against numbers and each other, infinities, subnormals and ordinary values.
const F32_PAIRS: i64[][] = [
  [0x00000000, 0x80000000],
  [0x80000000, 0x00000000],
  [0x7FC00000, 0x3F800000],
  [0x3F800000, 0x7FC00000],
  [0xFFC00001, 0x7FA00002],
  [0x7FA00002, 0xFFC00001],
  [0xFF800000, 0x7F800000],
  [0x7F800000, 0xFF800000],
  [0x3FC00000, 0x40200000],
  [0xBF800000, 0xC0000000],
  [0x00000001, 0x00000000],
  [0x80000001, 0x80000000],
  [0x7F800000, 0x7FC00000],
  [0xFFC00000, 0xFF800000],
  [0x3F800000, 0x3F800000],
  [0x80000000, 0x80000000],
]
const F64_PAIRS: i64[][] = [
  [0x0000000000000000, 0x8000000000000000],
  [0x8000000000000000, 0x0000000000000000],
  [0x7FF8000000000000, 0x3FF0000000000000],
  [0x3FF0000000000000, 0x7FF8000000000000],
  [0xFFF8000000000001, 0x7FF4000000000002],
  [0x7FF4000000000002, 0xFFF8000000000001],
  [0xFFF0000000000000, 0x7FF0000000000000],
  [0x7FF0000000000000, 0xFFF0000000000000],
  [0x3FF8000000000000, 0x4004000000000000],
  [0xBFF0000000000000, 0xC000000000000000],
  [0x0000000000000001, 0x0000000000000000],
  [0x8000000000000001, 0x8000000000000000],
]

// promote_low reads lanes 0 and 1; lanes 2 and 3 carry values that must not leak through.
const PROMOTE_INPUTS: i64[][] = [
  [0x00000000, 0x80000000, 0x3F800000, 0x40000000],
  [0x3FC00000, 0xC0490FDB, 0x7F800000, 0xFF800000],
  [0x7F800000, 0xFF800000, 0x00000000, 0x00000000],
  [0x00000001, 0x807FFFFF, 0x3F800000, 0x3F800000],
  [0x7F7FFFFF, 0x7FC00000, 0x12345678, 0x9ABCDEF0],
]
const DEMOTE_INPUTS: i64[][] = [
  [0x0000000000000000, 0x8000000000000000],
  [0x3FF8000000000000, 0xC00921FB54442D18], // 1.5, -pi
  [0x7FF0000000000000, 0xFFF0000000000000],
  [0x3FF0000010000000, 0x3FF0000030000000], // ties to even: down, then up
  [0x47EFFFFFF0000000, 0xC7EFFFFFF0000000], // rounds to ±inf
  [0x47EFFFFFE0000000, 0x7E37E43C8800759C], // FLT_MAX exactly, then 1e300 overflows
  [0x3690000000000000, 0x3698000000000000], // tie to 0, then to the least subnormal
  [0x01A56E1FC2F8F359, 0x7FF8000000000000], // 1e-300 underflows to +0, canonical NaN
]
const CONVERT_INPUTS: i64[][] = [
  [0, -1, 7, 7],
  [0x7FFFFFFF, -2147483648, 1, 1],
  [1, -2, 0x7FFFFFFF, -2147483648],
  [123456789, -987654321, 0, 0],
]

// ── the writers ─────────────────────────────────────────────────────────────────────

const PRELUDE = [
  "function v4(a: i32, b: i32, c: i32, d: i32): v128 {",
  "  __store_i32__(0, a)", "  __store_i32__(4, b)", "  __store_i32__(8, c)",
  "  __store_i32__(12, d)", "  __load_v128__(0)", "}", "",
  "function v2(a: i64, b: i64): v128 {", "  __store_i64__(0, a)",
  "  __store_i64__(8, b)", "  __load_v128__(0)", "}", "",
  "function show4(x: v128) {", "  __store_v128__(16, x)",
  "  print(__load_i32__(16))", "  print(__load_i32__(20))",
  "  print(__load_i32__(24))", "  print(__load_i32__(28))", "}", "",
  "function show2(x: v128) {", "  __store_v128__(16, x)",
  "  print(__load_i64__(16))", "  print(__load_i64__(24))", "}", "",
]

type Case = {
  path: string,
  blurb: string[],
  prelude: string[],
  body: string[],
  logs: string[],
}

function newCase(path: string, blurb: string[], prelude: string[]): Case {
  { path: path, blurb: blurb, prelude: prelude, body: [], logs: [] }
}

// Binds a vector built from four i32 or two i64 lane bit patterns; answers its name.
function vec(c: Case, lanes: readonly i64[]): string {
  const name = "x" + toString(c.body.length)
  const lits: string[] = []
  for x in lanes {
    if lanes.length == 4 { lits.push(litI32(x)) } else { lits.push(litI64(x)) }
  }
  let mk = "v2"
  if lanes.length == 4 { mk = "v4" }
  c.body.push("  const \{name} = \{mk}(\{join(lits, ", ")})")
  name
}

function write(c: Case) {
  const text = ["// @run"]
  for l in c.logs { text.push("// @log " + l) }
  for l in c.blurb { text.push("// " + l) }
  text.push(
    "// Generated by scripts/gen-conv-cases.vl; the expected lines are its model of",
  )
  text.push("// the wasm spec. Edit the generator, not this file.")
  for l in c.prelude { text.push(l) }
  text.push("function main() {")
  for l in c.body { text.push(l) }
  text.push("}")
  text.push("main()")
  text.push("")
  writeOrDie(c.path, join(text, "\n"))
}

// pmin is `b < a ? b : a`, pmax `a < b ? b : a`.
function pick(op: string, a: i64, b: i64, isF32: boolean): i64 {
  if op == "pmin" {
    if floatLt(b, a, isF32) { return b }
    return a
  }
  if floatLt(a, b, isF32) { return b }
  a
}

function genPminmax(root: string) {
  const c = newCase(
    root + "/simd/float-pminmax.vl",
    [
      "f32x4 and f64x2 pmin/pmax over ±0, signed and payload-carrying NaNs, infinities and",
      "subnormals. pmin is `b < a ? b : a` and pmax `a < b ? b : a`, so each lane is one",
      "operand's bits unchanged: x86 `minps d, s` is `pmin(s, d)`. Printed as bit patterns.",
    ],
    PRELUDE,
  )
  for shape in ["f32x4", "f64x2"] {
    const isF32 = shape == "f32x4"
    let pairs = F64_PAIRS
    let n = 2
    let width = 64
    if isF32 {
      pairs = F32_PAIRS
      n = 4
      width = 32
    }
    let i = 0
    while i < pairs.length {
      const ps = pairs.slice(i, i + n)
      const la: i64[] = []
      const lb: i64[] = []
      for p in ps {
        la.push(p[0])
        lb.push(p[1])
      }
      const a = vec(c, la)
      const b = vec(c, lb)
      for op in ["pmin", "pmax"] {
        c.body.push("  show\{toString(n)}(__\{op}_\{shape}__(\{a}, \{b}))")
        for p in ps {
          c.logs.push(toString(wrapBits(pick(op, p[0], p[1], isF32), width)))
        }
      }
      i = i + n
    }
  }
  write(c)
}

function genConvert(root: string) {
  const c = newCase(
    root + "/simd/float-convert.vl",
    [
      "promote_low_f32x4 (lanes 0 and 1 to f64), demote_f64x2_zero (to f32 lanes 0 and 1,",
      "rounding to nearest-even, with lanes 2 and 3 zero) and convert_low_i32x4_s/u (exact).",
      "A NaN input is the canonical one: the spec fixes a canonical result but not its sign, so",
      "the exact bits rely on the engines keeping the sign, as x86 does. Printed as bit patterns.",
    ],
    PRELUDE,
  )
  // Only the canonical NaN is fed to promote: the spec makes its result a canonical NaN of
  // either sign, and leaves a payload-carrying NaN's to the engine.
  for ls in PROMOTE_INPUTS {
    c.body.push("  show2(__promote_low_f32x4__(" + vec(c, ls) + "))")
    for x in ls.slice(0, 2) { c.logs.push(toString(promoteBits(x))) }
  }
  for ls in DEMOTE_INPUTS {
    c.body.push("  show4(__demote_f64x2_zero__(" + vec(c, ls) + "))")
    for x in ls { c.logs.push(toString(wrapBits(demoteBits(x), 32))) }
    c.logs.push("0")
    c.logs.push("0")
  }
  for sign in ["s", "u"] {
    for ls in CONVERT_INPUTS {
      c.body.push("  show2(__convert_low_i32x4_\{sign}__(\{vec(c, ls)}))")
      for x in ls.slice(0, 2) {
        let v = wrapBits(x, 32)
        if sign == "u" { v = maskBits(x, 32) }
        c.logs.push(toString(intToF64Bits(v)))
      }
    }
  }
  write(c)
}

function genTruncSat(root: string) {
  const c = newCase(
    root + "/numerics/trunc-sat.vl",
    [
      "The eight scalar saturating truncations over ±0, fractions, subnormals, the bounds of",
      "each result on both sides, ±inf and signed NaNs: NaN gives 0 and an out-of-range",
      "operand clamps to the result's minimum or maximum, where `as!` would trap.",
    ],
    [],
  )
  for src in ["f32", "f64"] {
    const isF32 = src == "f32"
    let edges = F64_EDGES
    let mk = "f64fromBits"
    if isF32 {
      edges = F32_EDGES
      mk = "f32fromBits"
    }
    for dst in ["i32", "i64"] {
      let width = 64
      if dst == "i32" { width = 32 }
      for sign in ["s", "u"] {
        const name = "__trunc_sat_\{src}_\{sign}_\{dst}__"
        for e in edges {
          let l = litI64(e)
          if isF32 { l = litI32(e) }
          c.body.push("  print(\{name}(\{mk}(\{l})))")
          c.logs.push(toString(truncSatBits(e, isF32, width, sign == "s")))
        }
      }
    }
  }
  write(c)
}

function checkCoverage(root: string) {
  const parts: string[] = []
  for p in ["/simd/float-pminmax.vl", "/simd/float-convert.vl", "/numerics/trunc-sat.vl"] {
    const t = readTextFile(root + p)
    if t is IoError {
      fail("cannot read " + root + p + ": " + t.msg)
      return
    }
    parts.push(t)
  }
  const text = join(parts, "")
  const missing: string[] = []
  for r in specTable() {
    if !text.includes(r.vl + "(") { missing.push(r.vl) }
  }
  if missing.length > 0 {
    fail("rows with no generated case: " + join(missing, ", "))
  }
}

// The bytes of a function body that are its one instruction: the body is no locals,
// `local.get 0` (and `local.get 1`), the instruction, an optional `return`, `end`. A body
// of any other shape is answered whole.
function instrOf(body: readonly i32[]): i32[] {
  const n = body.length
  if (
    n < 5
    || body[0] != 0x00
    || body[1] != 0x20
    || body[2] != 0x00
    || body[n - 1] != 0x0B
  ) {
    return body.slice(0, n)
  }
  let lo = 3
  if n - 1 - 5 >= 1 && body[3] == 0x20 && body[4] == 0x01 { lo = 5 }
  let hi = n - 1
  if hi - lo >= 2 && body[hi - 1] == 0x0F { hi = hi - 1 }
  body.slice(lo, hi)
}

function bytesRepr(xs: readonly i32[]): string {
  const hex = "0123456789abcdef"
  let s = "b'"
  for b in xs {
    s = s
      + "\\x"
      + hex.slice(b >> 4, (b >> 4) + 1)
      + hex.slice(b & 15, (b & 15) + 1)
  }
  s + "'"
}

// Builds one module calling every intrinsic in spec order, each in its own function whose
// body is `local.get 0; <instr>; return; end`, and checks (1) each body's instruction
// bytes against the spec table and (2) binaryen's disassembly names.
function verify() {
  const rows = specTable()
  const lines: string[] = []
  for k in 0 until rows.length {
    const w = rows[k].wasm
    let ps = "x: v128"
    if w.startsWith("i32.") || w.startsWith("i64.") {
      ps = "x: f64"
      if w.includes("_f32_") { ps = "x: f32" }
    } else if w.includes(".pmin") || w.includes(".pmax") {
      ps = "x: v128, y: v128"
    }
    let args = "x"
    if ps.includes("y:") { args = "x, y" }
    lines.push(
      "export function k\{toString(k)}(\{ps}) { \{rows[k].vl}(\{args}) }",
    )
  }
  const built = buildAndDisassemble(
    join(lines, "\n") + "\n",
    [
      "--enable-simd", "--enable-nontrapping-float-to-int", "--enable-gc",
      "--enable-reference-types",
    ],
  )
  const code = codeSection(built.wasm)
  const count = leb(code, 0)
  let i = count.next
  const bodies: i32[][] = []
  for _ in 0 until count.v {
    const size: Leb = leb(code, i)
    bodies.push(code.slice(size.next, size.next + size.v))
    i = size.next + size.v
  }
  const got: i32[][] = []
  let start = bodies.length - rows.length
  if start < 0 { start = 0 }
  for body in bodies.slice(start, bodies.length) { got.push(instrOf(body)) }
  let same = got.length == rows.length
  const pairs: string[] = []
  for k in 0 until rows.length {
    const want = [rows[k].prefix]
    const s = rows[k].sub
    if s < 0x80 {
      want.push(s)
    } else {
      want.push((s & 0x7F) | 0x80)
      want.push(s >> 7)
    }
    if k >= got.length { continue }
    if pairs.length < 3 {
      pairs.push("(\{bytesRepr(got[k])}, \{bytesRepr(want)})")
    }
    let eq = got[k].length == want.length
    for j in 0 until want.length {
      if eq && got[k][j] != want[j] { eq = false }
    }
    if !eq { same = false }
  }
  const alts: NameAlt[] = [
    { prefix: "f32x4.", tail: 1 },
    { prefix: "f64x2.", tail: 1 },
    { prefix: "i32.trunc_sat_", tail: 1 },
    { prefix: "i64.trunc_sat_", tail: 1 },
  ]
  const names = findNames(built.dis, alts)
  const bad: string[][] = []
  for k in 0 until rows.length {
    if k < names.length && rows[k].wasm != names[k] {
      bad.push([rows[k].wasm, names[k]])
    }
  }
  let verdict = "DIFFERENT from"
  if same { verdict = "equal to" }
  print(
    "opcodes: \{toString(got.length)} emitted, \{verdict} the spec table's \{toString(rows.length)}; wasm-dis: \{toString(names.length)} decoded, \{toString(bad.length)} disagree",
  )
  if !same || names.length != rows.length || bad.length > 0 {
    fail("verify failed: \{pairsRepr(bad.slice(0, 5))} [\{join(pairs, ", ")}]")
  }
}

function main() {
  const args = programArgs()
  if args is Utf8Error {
    fail("gen-conv-cases: an argument is not UTF-8")
    return
  }
  const root = casesRoot(args)
  genPminmax(root)
  genConvert(root)
  genTruncSat(root)
  checkCoverage(root)
  if hasFlag(args, "--verify") { verify() }
}

main()
