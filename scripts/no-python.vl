// The repo carries no Python: a hard check, not a ratchet.
//
//     vl run scripts/no-python.vl
//
// Fails (exit 1, one sentence per hit naming file and line) on any tracked `.py` file, and
// on any `python` / `python3` word on a non-comment line of a tracked `.sh`, `.yml`, `.yaml`,
// `.ts` or `.vl` file. Prose in `.md` and comment lines are not scanned, so history may still
// name the language. Run it from the checkout root: it asks `git` about the working directory.

import { IoError } from "std:fs"
import { exit, runProgram } from "std:process"
import { decodeUtf8Lossy } from "std:utf8"
import { split, startsWith, trimStart } from "std:str"
import { toString } from "std:fmt"

// Built from pieces so this file does not contain the word it forbids.
const WORD = "py" + "thon"

// git's ERE: the word, optionally followed by a version digit, standing alone (not part of a
// path, a dotted name or a longer identifier).
const PATTERN = "(^|[^A-Za-z0-9_./-])" + WORD + "3?([^A-Za-z0-9_.]|$)"

function git(args: readonly string[]): string[] {
  const r = runProgram("git", args)
  if r is IoError {
    print("no-python: cannot run git (\{r.msg})")
    exit(1)
    return []
  }
  // `git grep` exits 1 when nothing matched; anything above that is a real failure.
  if r.code > 1 {
    print("no-python: `git \{args[0]}` exited \{toString(r.code)}")
    exit(1)
    return []
  }
  split(decodeUtf8Lossy(r.stdout), "\n")
}

function isComment(text: string): boolean {
  const t = trimStart(text)
  startsWith(t, "#")
    || startsWith(t, "//")
    || startsWith(t, "*")
    || startsWith(t, "/*")
}

function main() {
  let bad = 0
  for path in git(["ls-files", "--", "*.py"]) {
    if path.length == 0 { continue }
    print(
      "no-python: \{path} is a tracked .py file; write the tool in VL instead",
    )
    bad = bad + 1
  }
  const hits = git(
    [
      "grep",
      "-nI",
      "-E",
      PATTERN,
      "--",
      "*.sh",
      "*.yml",
      "*.yaml",
      "*.ts",
      "*.vl",
    ],
  )
  for hit in hits {
    // path:line:text — the path and the line number hold no colon.
    const a = hit.indexOf(":")
    if a < 0 { continue }
    const rest = hit.slice(a + 1, hit.length)
    const b = rest.indexOf(":")
    if b < 0 { continue }
    const text = rest.slice(b + 1, rest.length)
    if isComment(text) { continue }
    print(
      "no-python: \{hit.slice(0, a)} line \{rest.slice(0, b)} invokes or names \{WORD}; the repo has none: port the step to VL",
    )
    bad = bad + 1
  }
  if bad > 0 {
    print(
      "no-python: \{bad} hit(s); the owner's directive is zero Python (docs/internals/python-removal.md)",
    )
    exit(1)
    return
  }
  print("no-python: clean")
}

main()
