// Run the repro filed under every defect heading of a docs inventory and report which rows
// no longer behave as filed. A row's status line files an outcome, its `Repro:` block is the
// witness, and an optional `Want:` block or `// PRINTS` line pins the output; `--strict`
// also fails on a row it cannot grade. The row grammar is `scripts/lib/inventory.vl`.
//
//     vl run scripts/check-filed-witnesses.vl -- [--strict] [--json OUT] [--shard K/N] <doc-or-dir>...
//     vl run scripts/check-filed-witnesses.vl -- --self-test
//
// Run it from the checkout root. Rows are graded in chunks of one `vl check --codegen --batch`
// and one `vl run --batch` of the modules it kept, `$JOBS` chunks at a time (default 4) by
// `xargs -P`; a row the batches leave unanswered is graded alone, and an outcome is cached under the seed, host, std and
// grader that produced it (`$WITNESS_CACHE` names the directory, 0 turns it off). Shell tools
// stand in for what `std:process` and `std:fs` lack (`dogfood:` rows in ROADMAP.md).

import { IoError, listDir, readFile, readTextFile, writeTextFile } from "std:fs"
import { exit, runProgram } from "std:process"
import { getEnv } from "std:env"
import { programArgs } from "std:args"
import { Utf8Error, decodeUtf8Lossy } from "std:utf8"
import { parseJson } from "std:json"
import { parseI32, toString } from "std:fmt"
import {
  endsWith,
  join,
  replaceAll,
  split,
  startsWith,
  toLowerAscii,
} from "std:str"
import { sorted } from "std:array"
import {
  JsonMap,
  Proc,
  cpPrefix,
  die,
  envOr,
  exists,
  fanOutArgv,
  findFrom,
  firstLine,
  isDigit,
  jsonStr,
  rstripWs,
  splitLines,
  stripWs,
  univNl,
  wsLen,
} from "./lib/common"
import {
  IdKey,
  OUTCOMES_SORTED,
  contains,
  declaredOutcome,
  headOf,
  isAnyHead,
  isRowHead,
  isWordByte,
  leadWord,
  matchSec,
  negatedBefore,
  padTo,
  resolve,
  rstripByte,
  skipWs,
  sortKeys,
  statusJoinContinues,
  stripByte,
} from "./lib/inventory"
import { numField, strField } from "./lib/corpus"
import {
  Cached,
  ROW_MARK,
  decodeRecords,
  encodeRecords,
  fnvFeed,
  hex64,
} from "./lib/witness-cache"

const VL = "./scripts/vl-host/target/release/vl"
const COMPILER = "build/vl-compiler.wasm"
const SELF = "scripts/check-filed-witnesses.vl"
const SIDECAR = "build/vl-compiler.wasm.src"
const REPEAT_MAX: i64 = 50000000
const CHUNK = 64

// A section of an inventory doc: one `### <ID> — <title>` row and what it filed.
type Row = {
  id: string,
  title: string,
  hasStatus: boolean,
  status: string,
  repro: string,
  wantLabels: i32,
  want: string,
  doc: string,
  line: i32,
}

// What the compiler did with one witness: the outcome, a 200-code-point detail, and the
// run's whole stdout when it ran.
type Ran = { outcome: string, detail: string, stdout: string }

// A graded row, or an ungradeable one when `why` is not empty.
type Graded = {
  row: Row,
  declared: string,
  actual: string,
  detail: string,
  why: string,
}

// ── text helpers ─────────────────────────────────────────────────────────────────────

// The `<name>.vl` of a `// file: <name>.vl` marker line, or "".
function fileMark(ln: string): string {
  if !startsWith(ln, "// file: ") { return "" }
  let i = 9
  while i < ln.length && wsLen(ln, i) == 0 { i = i + 1 }
  const name = ln.slice(9, i)
  if skipWs(ln, i) != ln.length { return "" }
  if name.length < 4 || !endsWith(name, ".vl") { return "" }
  name
}

// `src` with every `@@repeat(N, "text")@@` replaced by N copies of `text`.
function expandRepeats(src: string): string {
  const open = "@@repeat("
  let out = ""
  let from = 0
  let at = findFrom(src, open, 0)
  while at >= 0 {
    let i = at + open.length
    const d0 = i
    while i < src.length && isDigit(src[i]) { i = i + 1 }
    let ok = i > d0 && startsWith(src.slice(i, src.length), ", \"")
    let t0 = 0
    let t1 = 0
    if ok {
      t0 = i + 3
      t1 = findFrom(src, "\"", t0)
      ok = t1 >= 0 && startsWith(src.slice(t1, src.length), "\")@@")
    }
    if !ok {
      at = findFrom(src, open, at + 1)
      continue
    }
    let n: i64 = 0
    let k = d0
    while k < i {
      n = n * 10 + ((src[k] - 48) as i64)
      k = k + 1
    }
    if n > REPEAT_MAX {
      die(
        "check-filed-witnesses: @@repeat count \{toString(n)} is over the \{toString(REPEAT_MAX)} cap",
        1,
      )
    }
    const text = src.slice(t0, t1)
    out = out + src.slice(from, at)
    let c: i64 = 0
    const parts: string[] = []
    while c < n {
      parts.push(text)
      c = c + 1
    }
    out = out + join(parts, "")
    from = t1 + 4
    at = findFrom(src, open, from)
  }
  out + src.slice(from, src.length)
}

// ── JSON: a string escaped to ASCII, `\uXXXX` beyond it ──────────────────────────────

// Whether the status files a parse-stage refusal: `parse[ -](error|stage)|at the parse\b`.
function namesParseError(status: string): boolean {
  const low = toLowerAscii(status)
  let best = -1
  for needle in ["parse error", "parse-error", "parse stage", "parse-stage"] {
    const p = findFrom(low, needle, 0)
    if p != -1 && (best == -1 || p < best) { best = p }
  }
  let from = 0
  while from >= 0 {
    const p = findFrom(low, "at the parse", from)
    if p == -1 { break }
    const end = p + 12
    if end == low.length || !isWordByte(low[end]) {
      if best == -1 || p < best { best = p }
      break
    }
    from = p + 1
  }
  best != -1 && !negatedBefore(low, best)
}

const INVALID_MARKERS = [
  "Invalid input WebAssembly code", "wasm validation", "failed to parse",
  "type mismatch: expected", "WebAssembly translation error",
  "validation error",
]
const TRAP_MARKERS = [
  "wasm trap", "unreachable", "out of bounds", "divide by zero",
  "null reference", "cast failure", "integer overflow",
]
// The banner `vl run` prints before a trap inside the compiler itself.
const COMPILER_TRAPPED = "the compiler itself trapped"

function anyIn(s: string, needles: string[]): boolean {
  for n in needles {
    if contains(s, n) { return true }
  }
  false
}

// ── processes and directories ────────────────────────────────────────────────

function spawn(cmd: string, args: string[]): Proc {
  const r = runProgram(cmd, args)
  if r is IoError {
    die("check-filed-witnesses: cannot run \{cmd} (\{r.msg})", 1)
    return { code: -1, out: "", err: "" }
  }
  {
    code: r.code,
    out: univNl(decodeUtf8Lossy(r.stdout)),
    err: univNl(decodeUtf8Lossy(r.stderr)),
  }
}

// The per-channel bound in seconds: `$WITNESS_TIMEOUT`, else 120.
function timeoutSecs(): string {
  const t = getEnv("WITNESS_TIMEOUT")
  if t is string {
    if parseI32(stripWs(t)) == null {
      die("check-filed-witnesses: WITNESS_TIMEOUT is not an integer: " + t, 1)
    }
    return stripWs(t)
  }
  "120"
}

// Whether `timeout` stopped the channel (124) or a signal killed it (137, 143): a reading
// of the box's load, not of the witness, so it never becomes a filed outcome.
function wasKilled(p: Proc): boolean {
  p.code == 124 || p.code == 137 || p.code == 143 || p.code < 0
}

function vlOnce(args: string[]): Proc {
  const full = [timeoutSecs(), VL]
  for a in args { full.push(a) }
  spawn("timeout", full)
}

// One `vl` subcommand on a witness, bounded per `timeoutSecs`, retried once if killed.
function vl(args: string[]): Proc {
  const p = vlOnce(args)
  if wasKilled(p) { return vlOnce(args) }
  p
}

// The outcome for a channel killed on both tries; `grade` reports the row as not graded.
function timedOut(channel: string): Ran {
  {
    outcome: "timed_out",
    detail: "`vl \{channel}` was stopped after \{timeoutSecs()} s twice: load, or a slow compile; re-run the row alone",
    stdout: "",
  }
}

function readText(path: string): string {
  const t = readTextFile(path)
  if t is IoError {
    die("check-filed-witnesses: cannot read \{path} (\{t.msg})", 1)
    return ""
  }
  t
}

function writeText(path: string, text: string) {
  const w = writeTextFile(path, text)
  if w != null {
    die("check-filed-witnesses: cannot write \{path} (\{w.msg})", 1)
  }
}

// A fresh private directory from `mktemp -d`, under `$TMPDIR` when it is set.
function makeTempDir(): string {
  const p = spawn("mktemp", ["-d"])
  if p.code != 0 { die("check-filed-witnesses: mktemp -d failed: " + p.err, 1) }
  stripWs(p.out)
}

// ── witnesses: write each to its own directory, then classify what `vl` does ───────

// The `// file:` sections of a witness as alternating name and source; one unnamed
// section is `w.vl`. The last name is the entry the three channels run.
function splitFiles(src0: string): string[] {
  const src = expandRepeats(src0)
  const out: string[] = []
  let name = ""
  let body: string[] = []
  for ln in splitLines(src) {
    const m = fileMark(ln)
    if m != "" {
      if name != "" {
        out.push(name)
        out.push(rstripWs(join(body, "\n")) + "\n")
      }
      name = m
      body = []
    } else {
      body.push(ln)
    }
  }
  if name == "" { return ["w.vl", src] }
  out.push(name)
  out.push(rstripWs(join(body, "\n")) + "\n")
  out
}

// A witness written out: its entry's path, and its source when it is one file that names
// no relative path (so a copy under another name compiles the same program), else "".
type Staged = { entry: string, alone: string }

// Write the files of the repro staged at `dir/repro` beside it.
function stageWitness(dir: string): Staged {
  const files = splitFiles(readText(dir + "/repro"))
  let k = 0
  while k < files.length {
    writeText(dir + "/" + files[k], files[k + 1])
    k = k + 2
  }
  let alone = ""
  if (
    files.length == 2
    && !contains(files[1], "\"./")
    && !contains(files[1], "\"../")
  ) {
    alone = files[1]
  }
  { entry: dir + "/" + files[files.length - 2], alone: alone }
}

// Classify the witness staged in `dir` on the check, run and build channels.
function classify(dir: string): Ran {
  const f = stageWitness(dir).entry
  const chk = vl(["check", f, "--compiler", COMPILER])
  if wasKilled(chk) { return timedOut("check") }
  if chk.code != 0 {
    const diag = stripWs(chk.out + chk.err)
    if contains(diag, "(parse error)") {
      return {
        outcome: "witness_unparsed",
        detail: cpPrefix(diag, 200),
        stdout: "",
      }
    }
    return { outcome: "check_reject", detail: cpPrefix(diag, 200), stdout: "" }
  }
  classifyRun(dir, f)
}

// Classify the check-clean entry `f`, staged in `dir`, on the run and build channels.
function classifyRun(dir: string, f: string): Ran {
  const run = vl(["run", f, "--compiler", COMPILER])
  if wasKilled(run) { return timedOut("run") }
  if run.code == 0 {
    return {
      outcome: "runs",
      detail: cpPrefix(stripWs(run.out), 200),
      stdout: run.out,
    }
  }
  const err = stripWs(run.out + run.err)
  const detail = cpPrefix(err, 200)
  if contains(err, "emit error") {
    return { outcome: "emit_reject", detail: detail, stdout: "" }
  }
  // Without the compiler-trap banner, a run error naming an invalid module or a trap
  // already decides the row; only the rest need `vl build` to say if a module was written.
  if !contains(err, COMPILER_TRAPPED) {
    if anyIn(err, INVALID_MARKERS) {
      return { outcome: "silent_invalid_wasm", detail: detail, stdout: "" }
    }
    if anyIn(err, TRAP_MARKERS) {
      return { outcome: "trap_loads", detail: detail, stdout: "" }
    }
  }
  const out = dir + "/w.wasm"
  const bld = vl(["build", f, "--compiler", COMPILER, "-o", out])
  if wasKilled(bld) { return timedOut("build") }
  if bld.code != 0 && !exists(out) {
    return { outcome: "compiler_trap", detail: detail, stdout: "" }
  }
  if anyIn(err, INVALID_MARKERS) {
    return { outcome: "silent_invalid_wasm", detail: detail, stdout: "" }
  }
  if anyIn(err, TRAP_MARKERS) {
    return { outcome: "trap_loads", detail: detail, stdout: "" }
  }
  { outcome: "silent_invalid_wasm", detail: detail, stdout: "" }
}

// Leave `r` for `dir` in three files beside its witness.
function writeRan(dir: string, r: Ran) {
  writeText(dir + "/outcome", r.outcome)
  writeText(dir + "/detail", r.detail)
  writeText(dir + "/stdout", r.stdout)
}

// The timeout-bounded `vl` over a whole chunk; a kill or a crash only loses answers.
function vlBatch(args: string[]): Proc {
  const full = [timeoutSecs(), VL]
  for a in args { full.push(a) }
  spawn("timeout", full)
}

// The entries `vl check --batch --json` answered exit 0 for, by path.
function batchClean(entries: string[]): Map<string, boolean> {
  const clean: Map<string, boolean> = Map()
  // `vl check --batch` with no files checks the whole tree, so an empty chunk asks nothing.
  if entries.length == 0 { return clean }
  const args = ["check", "--batch", "--json"]
  for f in entries { args.push(f) }
  args.push("--compiler")
  args.push(COMPILER)
  const p = vlBatch(args)
  for l in splitLines(p.out) {
    if stripWs(l) == "" { continue }
    const j = parseJson(l)
    if j is JsonMap {
      if numField(j, "exit") == 0.0 { clean[strField(j, "file")] = true }
    }
  }
  clean
}

// The `copies` `vl check --batch --json --codegen` answered exit 0 for and kept the validated
// module of, as `kd/<name>.wasm`: the module `vl run` would compile, so running it skips a
// second check. A seed that cannot keep modules keeps none, and every row is graded as before.
// `failed` gets each copy the batch answered with a nonzero exit: no later check can call it clean.
function batchKept(
  copies: string[],
  kd: string,
  failed: Map<string, boolean>,
): Map<string, boolean> {
  const kept: Map<string, boolean> = Map()
  if copies.length == 0 { return kept }
  const args = [
    "VL_CHECK_KEEP_MODULES=" + kd,
    "timeout",
    timeoutSecs(),
    VL,
    "check",
    "--batch",
    "--json",
    "--codegen",
  ]
  for f in copies { args.push(f) }
  args.push("--compiler")
  args.push(COMPILER)
  const p = spawn("env", args)
  for l in splitLines(p.out) {
    if stripWs(l) == "" { continue }
    const j = parseJson(l)
    if j is JsonMap {
      const f = strField(j, "file")
      if numField(j, "exit") != 0.0 { failed[f] = true }
      if (
        numField(j, "exit") == 0.0
        && exists(kd + "/" + f.slice(lastSlash(f) + 1, f.length) + ".wasm")
      ) {
        kept[f] = true
      }
    }
  }
  kept
}

// Beside a witness whose last grading was not `runs`: grade it alone rather than in the
// batches, which would only hand it back unanswered.
const HINT_ALONE = "hint-alone"

// Grade the witnesses staged in `dirs` as `classify` would. One `vl check --codegen --batch`
// keeps each one-file row's module and one `vl run --batch` runs them; a row they cannot answer
// as `runs` is graded after a plain `vl check --batch`, alone, so a hang, trap or crash in one
// row moves no other row's grade.
function gradeChunk(dirs: string[]) {
  const staged: Staged[] = []
  const entries: string[] = []
  for d in dirs {
    const s = stageWitness(d)
    staged.push(s)
    entries.push(s.entry)
  }
  const copies: string[] = []
  const names: string[] = []
  const at: i32[] = []
  let k = 0
  while k < dirs.length {
    if staged[k].alone != "" && !exists(dirs[k] + "/" + HINT_ALONE) {
      const name = "cfw-" + toString(k) + ".vl"
      writeText(dirs[k] + "/" + name, staged[k].alone)
      copies.push(dirs[k] + "/" + name)
      names.push(name)
      at.push(k)
    }
    k = k + 1
  }
  const got: Map<i32, Ran> = Map()
  const failed: Map<string, boolean> = Map()
  if copies.length > 0 {
    const kd = dirs[0] + "/batch-keep"
    const kept = batchKept(copies, kd, failed)
    const wasms: string[] = []
    const wnames: string[] = []
    const wat: i32[] = []
    let c = 0
    while c < copies.length {
      if kept[copies[c]] ?? false {
        wasms.push(kd + "/" + names[c] + ".wasm")
        wnames.push(names[c] + ".wasm")
        wat.push(at[c])
      }
      c = c + 1
    }
    if wasms.length > 0 {
      const od = dirs[0] + "/batch-run"
      const args = ["run", "--batch", "--out-dir", od]
      for w in wasms { args.push(w) }
      args.push("--compiler")
      args.push(COMPILER)
      const p = vlBatch(args)
      // A row's `.err` is written before the next row starts, so an answer is whole once a
      // later row has one, or once the batch exited 0.
      let later = p.code == 0
      let i = wasms.length - 1
      while i >= 0 {
        const o = od + "/" + wnames[i] + ".out"
        const have = exists(o)
        if have && later && !exists(od + "/" + wnames[i] + ".err") {
          const bytes = readFile(o)
          if bytes is u8[] {
            const out = univNl(decodeUtf8Lossy(bytes))
            got[wat[i]] = {
              outcome: "runs",
              detail: cpPrefix(stripWs(out), 200),
              stdout: out,
            }
          }
        }
        if have { later = true }
        i = i - 1
      }
    }
  }
  // The rows still unanswered are checked once more, together, only when nothing has said
  // they fail: a row the codegen batch failed, or one graded alone by its hint, goes straight
  // to `classify`, whose own check decides it. Checked again here, a slow failing row (a
  // compiler trap) cost its chunk that compile twice.
  const bad: boolean[] = []
  for _ in dirs { bad.push(false) }
  let c0 = 0
  while c0 < copies.length {
    if failed[copies[c0]] ?? false { bad[at[c0]] = true }
    c0 = c0 + 1
  }
  const rest: string[] = []
  k = 0
  while k < dirs.length {
    if exists(dirs[k] + "/" + HINT_ALONE) { bad[k] = true }
    if got[k] == null && !bad[k] { rest.push(entries[k]) }
    k = k + 1
  }
  const clean = batchClean(rest)
  k = 0
  while k < dirs.length {
    const r = got[k]
    if r != null {
      writeRan(dirs[k], r)
    } else if clean[entries[k]] ?? false {
      writeRan(dirs[k], classifyRun(dirs[k], entries[k]))
    } else {
      writeRan(dirs[k], classify(dirs[k]))
    }
    k = k + 1
  }
}

function readRan(dir: string): Ran {
  {
    outcome: readText(dir + "/outcome"),
    detail: readText(dir + "/detail"),
    stdout: readText(dir + "/stdout"),
  }
}

// Witness `k`'s directory under `root`.
function rowDir(root: string, k: i32): string { root + "/" + toString(k) }

// Make one directory under `root` for each witness `srcs[at[i]]`, leave its source there as
// `repro`, and answer the directories in the order of `at`.
function stageAll(root: string, srcs: string[], at0: i32[]): string[] {
  const dirs: string[] = []
  for k in at0 { dirs.push(rowDir(root, k)) }
  let at = 0
  while at < dirs.length {
    const batch = ["-p"]
    while at < dirs.length && batch.length < 500 {
      batch.push(dirs[at])
      at = at + 1
    }
    const p = spawn("mkdir", batch)
    if p.code != 0 {
      die("check-filed-witnesses: mkdir failed: " + p.out + p.err, 1)
    }
  }
  let i = 0
  while i < dirs.length {
    writeText(dirs[i] + "/repro", srcs[at0[i]])
    i = i + 1
  }
  dirs
}

// Grade every staged directory in chunks, `jobs` chunks at a time. Serial grading runs one
// chunk in this process; parallel grading builds this file once and lets `xargs -P` fan the
// chunk lists out one per worker.
function gradeAll(root: string, dirs: string[], jobs: i32) {
  if jobs <= 1 || dirs.length <= 1 {
    gradeChunk(dirs)
    return 0
  }
  let size = (dirs.length + jobs * 4 - 1) / (jobs * 4)
  if size > CHUNK { size = CHUNK }
  // Rows go to chunks round-robin: rows filed together cost alike (the `@@repeat` witnesses
  // sit side by side), and a run of slow ones in one chunk was the whole row's tail.
  // The rows known to be slow (graded alone by their hint, or an expanded `@@repeat`) are dealt
  // first, so they land in the first chunks `xargs` starts rather than in the last.
  const order: string[] = []
  for d in dirs {
    if (
      exists(d + "/" + HINT_ALONE)
      || contains(readText(d + "/repro"), "@@repeat(")
    ) {
      order.push(d)
    }
  }
  for d in dirs {
    if (
      !(exists(d + "/" + HINT_ALONE)
        || contains(readText(d + "/repro"), "@@repeat("))
    ) {
      order.push(d)
    }
  }
  const count = (order.length + size - 1) / size
  const parts: string[][] = []
  for _ in 0 until count { parts.push([]) }
  let at = 0
  while at < order.length {
    parts[at % count].push(order[at])
    at = at + 1
  }
  const lists: string[] = []
  for part in parts {
    const list = root + "/chunk-" + toString(lists.length)
    writeText(list, join(part, "\n"))
    lists.push(list)
  }
  const grader = root + "/grader.wasm"
  const b = spawn(VL, ["build", SELF, "--compiler", COMPILER, "-o", grader])
  if b.code != 0 {
    die(
      "check-filed-witnesses: cannot build " + SELF + ":\n" + b.out + b.err,
      1,
    )
  }
  writeText(root + "/chunks", join(lists, "\n") + "\n")
  const x = spawn(
    "sh",
    fanOutArgv(
      root + "/chunks",
      toString(jobs),
      [VL, "run", grader, "--", "--grade-chunk"],
    ),
  )
  if x.code != 0 {
    die("check-filed-witnesses: a grading worker failed:\n" + x.out + x.err, 1)
  }
  0
}

// ── the outcome cache ───────────────────────────────────────────────────────────

// The directory the cache lives in: `$WITNESS_CACHE` when it names one, none when it is 0,
// else `filed-witnesses` under `vl`'s own cache root (`$VL_CACHE_DIR`, else
// `$XDG_CACHE_HOME/vl`, else `$HOME/.cache/vl`), or "" when none of those is set.
function cacheDir(): string {
  const own = envOr("WITNESS_CACHE", "")
  if own == "0" { return "" }
  if own != "" { return own }
  let base = envOr("VL_CACHE_DIR", "")
  if base == "" && envOr("XDG_CACHE_HOME", "") != "" {
    base = envOr("XDG_CACHE_HOME", "") + "/vl"
  }
  if base == "" && envOr("HOME", "") != "" {
    base = envOr("HOME", "") + "/.cache/vl"
  }
  if base == "" { return "" }
  base + "/filed-witnesses"
}

// Everything a witness's outcome can depend on besides its own text, or "" when any part
// cannot be read: the seed's, the host's and the grader's bytes, the std tree `vl` resolves,
// and every `VL_*` setting but the two that only size the host's own cache.
function cacheKeyText(): string {
  const files = [COMPILER, VL, SELF]
  const libs = listDir("scripts/lib")
  if libs is IoError { return "" }
  for n in sorted(libs, (a: string, b: string): boolean => a < b) {
    if endsWith(n, ".vl") { files.push("scripts/lib/" + n) }
  }
  const h = spawn("sha256sum", files)
  if h.code != 0 { return "" }
  const s = spawn(VL, ["std"])
  let stdLine = ""
  for l in splitLines(s.out) {
    if stdLine == "" && contains(l, " modules, ") { stdLine = stripWs(l) }
  }
  if s.code != 0 || stdLine == "" { return "" }
  const e = spawn("env", [])
  if e.code != 0 { return "" }
  const vars: string[] = []
  for l in splitLines(e.out) {
    if (
      startsWith(l, "VL_")
      && !startsWith(l, "VL_CACHE_DIR=")
      && !startsWith(l, "VL_CACHE_MAX_MB=")
    ) {
      vars.push(l)
    }
  }
  const env = sorted(vars, (a: string, b: string): boolean => a < b)
  "check-filed-witnesses cache 1\n" + h.out + stdLine + "\n" + join(env, "\n")
}

const HINTS_HEAD = "check-filed-witnesses hints 1"

// Whether a witness's outcome is a function of its text and the key: one that reads files,
// the environment, its arguments or a process could answer differently on the next run.
function cacheable(src: string): boolean {
  !anyIn(src, ["std:fs", "std:process", "std:env", "std:args"])
}

function readRecords(path: string, head: string): Map<string, Cached> {
  const t = readTextFile(path)
  if t is IoError { return Map() }
  decodeRecords(t, head)
}

// Replace `path` with `text` in one rename, so a concurrent reader sees one whole file.
function writeRecords(dir: string, path: string, text: string) {
  const t = spawn("mktemp", [dir + "/.write.XXXXXXXX"])
  if t.code != 0 { return 0 }
  const tmp = stripWs(t.out)
  if writeTextFile(tmp, text) != null {
    spawn("rm", ["-f", tmp])
    return 0
  }
  spawn("mv", ["-f", tmp, path])
  0
}

function writeMap(
  dir: string,
  path: string,
  head: string,
  m: Map<string, Cached>,
) {
  const keys = sorted(m.keys(), (a: string, b: string): boolean => a < b)
  const vals: Cached[] = []
  for k in keys {
    const v = m[k]
    if v != null { vals.push(v) }
  }
  writeRecords(dir, path, encodeRecords(head, keys, vals))
}

function lastSlash(s: string): i32 {
  let i = s.length - 1
  while i >= 0 && s[i] != 47 { i = i - 1 }
  i
}

// `r`, graded in row directory `d`, as a record whose texts name `d` only through `ROW_MARK`,
// or null when it cannot be: a timed-out run, or a text that names `d`'s run some other way.
function toCached(r: Ran, d: string): Cached | null {
  if r.outcome == "timed_out" { return null }
  if contains(r.detail, ROW_MARK) || contains(r.stdout, ROW_MARK) {
    return null
  }
  const pre = d + "/"
  const run = d.slice(0, lastSlash(d))
  const tag = run.slice(lastSlash(run) + 1, run.length)
  const det = replaceAll(r.detail, pre, ROW_MARK)
  const out = replaceAll(r.stdout, pre, ROW_MARK)
  if contains(det, tag) || contains(out, tag) { return null }
  // A detail cut at its length bound can end inside the directory's path.
  let j = 1
  while j < pre.length {
    if endsWith(det, pre.slice(0, j)) { return null }
    j = j + 1
  }
  { outcome: r.outcome, detail: det, stdout: out, plen: pre.length }
}

// The record `c` read back in row directory `d`, or null when `d`'s path is another length,
// which would have cut a long detail at another place.
function fromCached(c: Cached, d: string): Ran | null {
  const pre = d + "/"
  if c.plen != pre.length { return null }
  {
    outcome: c.outcome,
    detail: replaceAll(c.detail, ROW_MARK, pre),
    stdout: replaceAll(c.stdout, ROW_MARK, pre),
  }
}

// Stage, grade and read back every source in `srcs`, in order. With `useCache`, a witness the
// cache answers under this run's key is not run, and a witness last graded other than `runs`
// skips the run batch.
function runAll(srcs: string[], jobs: i32, useCache: boolean): Ran[] {
  const out: Ran[] = []
  if srcs.length == 0 { return out }
  const root = makeTempDir()
  let dir = ""
  if useCache { dir = cacheDir() }
  let head = ""
  if dir != "" && spawn("mkdir", ["-p", dir]).code == 0 {
    head = cacheKeyText()
  }
  const recPath = dir
    + "/"
    + hex64(fnvFeed(-3750763034362895579, head.bytes()))
    + ".rec"
  const hintPath = dir + "/hints.rec"
  let recs: Map<string, Cached> = Map()
  let hints: Map<string, Cached> = Map()
  if head != "" {
    recs = readRecords(recPath, head)
    hints = readRecords(hintPath, HINTS_HEAD)
  }
  const miss: i32[] = []
  let k = 0
  while k < srcs.length {
    let r: Ran | null = null
    const c = recs[srcs[k]]
    if c != null && cacheable(srcs[k]) { r = fromCached(c, rowDir(root, k)) }
    if r != null {
      out.push(r)
    } else {
      out.push({ outcome: "", detail: "", stdout: "" })
      miss.push(k)
    }
    k = k + 1
  }
  const dirs = stageAll(root, srcs, miss)
  let i = 0
  while i < miss.length {
    if hints.has(srcs[miss[i]]) { writeText(dirs[i] + "/" + HINT_ALONE, "") }
    i = i + 1
  }
  if dirs.length > 0 { gradeAll(root, dirs, jobs) }
  i = 0
  while i < miss.length {
    out[miss[i]] = readRan(dirs[i])
    i = i + 1
  }
  if head != "" {
    let wrote = false
    for m in miss {
      const c = toCached(out[m], rowDir(root, m))
      if c != null && cacheable(srcs[m]) {
        recs[srcs[m]] = c
        wrote = true
      }
    }
    let hinted = false
    k = 0
    while k < srcs.length {
      const o = out[k].outcome
      if o == "runs" && hints.has(srcs[k]) {
        hints.delete(srcs[k])
        hinted = true
      } else if o != "runs" && o != "timed_out" && !hints.has(srcs[k]) {
        hints[srcs[k]] = { outcome: o, detail: "", stdout: "", plen: 0 }
        hinted = true
      }
      k = k + 1
    }
    if wrote {
      writeMap(dir, recPath, head, recs)
      // The newest eight keys stay; an older one is a seed nobody grades with any more.
      spawn(
        "sh",
        [
          "-c",
          "cd \"$1\" && ls -t | grep '^[0-9a-f]*\\.rec$' | tail -n +9 | xargs rm -f --",
          "prune",
          dir,
        ],
      )
    }
    if hinted { writeMap(dir, hintPath, HINTS_HEAD, hints) }
  }
  spawn("rm", ["-rf", root])
  out
}

// ── reading a doc ───────────────────────────────────────────────────────────────

function blankRow(doc: string): Row {
  {
    id: "",
    title: "",
    hasStatus: false,
    status: "",
    repro: "",
    wantLabels: 0,
    want: "",
    doc: doc,
    line: 0,
  }
}

// The indented program the `Repro` lead-in at `lines[i]` introduces, or "".
function blockAt(lines: string[], i: i32): string {
  const body: string[] = []
  let j = i + 1
  let scanned = 0
  while j < lines.length && scanned < 6 && !startsWith(lines[j], "    ") {
    if stripWs(lines[j]) != "" && headOf(lines[j], 2, 4) { break }
    j = j + 1
    scanned = scanned + 1
  }
  while (
    j < lines.length
    && (startsWith(lines[j], "    ") || stripWs(lines[j]) == "")
  ) {
    if startsWith(lines[j], "    ") {
      body.push(lines[j].slice(4, lines[j].length))
    } else {
      body.push("")
    }
    j = j + 1
  }
  const src = rstripWs(join(body, "\n"))
  if stripWs(src) == "" { return "" }
  src + "\n"
}

// The indented block directly under the `Want` lead-in at `lines[i]`, or "".
function wantBlock(lines: string[], i: i32): string {
  let j = i + 1
  while j < lines.length && stripWs(lines[j]) == "" { j = j + 1 }
  if j >= lines.length || !startsWith(lines[j], "    ") { return "" }
  const body: string[] = []
  while (
    j < lines.length
    && (startsWith(lines[j], "    ") || stripWs(lines[j]) == "")
  ) {
    if startsWith(lines[j], "    ") {
      body.push(lines[j].slice(4, lines[j].length))
    } else {
      body.push("")
    }
    j = j + 1
  }
  rstripWs(join(body, "\n")) + "\n"
}

function docLines(doc: string): string[] { splitLines(univNl(readText(doc))) }

// Every row section of `doc`, in order.
function parseDoc(doc: string): Row[] {
  const lines = docLines(doc)
  const rows: Row[] = []
  let cur = blankRow(doc)
  let open = false
  let i = 0
  while i < lines.length {
    const ln = lines[i]
    const m = matchSec(ln)
    if m.id != "" {
      if open { rows.push(cur) }
      cur = blankRow(doc)
      cur.id = m.id
      cur.title = m.title
      cur.line = i + 1
      open = true
      i = i + 1
      continue
    }
    if isAnyHead(ln) {
      if open { rows.push(cur) }
      open = false
      i = i + 1
      continue
    }
    if !open {
      i = i + 1
      continue
    }
    if !cur.hasStatus && startsWith(ln, "**") {
      const r = rstripWs(ln)
      if endsWith(r, "**") && r.length > 2 {
        cur.status = stripWs(stripByte(ln, 42))
        cur.hasStatus = true
      } else {
        const parts = [ln]
        let k = i + 1
        while k < lines.length {
          if !statusJoinContinues(lines[k]) { break }
          parts.push(lines[k])
          if endsWith(rstripWs(lines[k]), "**") {
            cur.status = stripWs(stripByte(join(parts, " "), 42))
            cur.hasStatus = true
            break
          }
          k = k + 1
        }
      }
    }
    if leadWord(ln, "Want") {
      cur.wantLabels = cur.wantLabels + 1
      if cur.wantLabels == 1 { cur.want = wantBlock(lines, i) }
      i = i + 1
      continue
    }
    if cur.repro == "" && leadWord(ln, "Repro") {
      cur.repro = blockAt(lines, i)
    }
    i = i + 1
  }
  if open { rows.push(cur) }
  rows
}

// Row-shaped headings `matchSec` did not parse, as alternating line number and heading.
function unparsedRowHeads(doc: string): string[] {
  const out: string[] = []
  const lines = docLines(doc)
  let i = 0
  while i < lines.length {
    if isRowHead(lines[i]) && matchSec(lines[i]).id == "" {
      out.push(toString(i + 1))
      out.push(stripWs(lines[i]))
    }
    i = i + 1
  }
  out
}

// ── grading a row against what its witness did ──────────────────────────────────

// Stdout as a `Want:` block can spell it: no trailing whitespace or trailing blank lines.
function normOutput(text: string): string {
  const ls: string[] = []
  for l in splitLines(text) { ls.push(rstripWs(l)) }
  rstripByte(join(ls, "\n"), 10)
}

// The outcome to compare with `want`, or an empty outcome and the reason it is ungradeable.
type Verdict = { got: string, why: string }

function grade(
  status: string,
  repro: string,
  hasWant: boolean,
  wanted: string,
  want: string,
  ran: Ran,
): Verdict {
  if ran.outcome == "timed_out" { return { got: "", why: ran.detail } }
  if ran.outcome == "witness_unparsed" {
    if !namesParseError(status) {
      return {
        got: "",
        why: "the witness does not PARSE, and the status does not file a parse error as the outcome",
      }
    }
    return { got: "check_reject", why: "" }
  }
  if ran.outcome != "runs" { return { got: ran.outcome, why: "" } }
  const mismatch = hasWant && normOutput(ran.stdout) != normOutput(wanted)
  if want == "silent_wrong_value" {
    const pr: string[] = []
    for l in splitLines(repro) {
      if contains(l, "// PRINTS") {
        const at = findFrom(l, "PRINTS", 0)
        pr.push(stripWs(l.slice(at + 6, l.length)))
      }
    }
    if pr.length == 0 && !hasWant {
      return {
        got: "",
        why: "declares a wrong VALUE but carries neither a `// PRINTS` line nor a `Want:` block",
      }
    }
    if pr.length > 0 && stripWs(ran.detail) == pr[pr.length - 1] {
      return { got: "silent_wrong_value", why: "" }
    }
    if mismatch {
      if pr.length > 0 { return { got: "wrong_output", why: "" } }
      return { got: "silent_wrong_value", why: "" }
    }
    return { got: "runs", why: "" }
  }
  if mismatch { return { got: "wrong_output", why: "" } }
  { got: "runs", why: "" }
}

// ── seed provenance, as `scripts/seed-provenance.vl` computes it ──────────────────

// FNV-1a over every `compiler/*.vl` in sorted name order, and how many there were.
type Identity = { hash: string, files: i32 }

function sourceIdentity(): Identity {
  const listed = listDir("compiler")
  if listed is IoError {
    die("check-filed-witnesses: cannot list compiler/ (" + listed.msg + ")", 1)
    return { hash: "", files: 0 }
  }
  const keys: IdKey[] = []
  for n in listed {
    if endsWith(n, ".vl") { keys.push({ pre: n, num: 0, rest: "", path: n }) }
  }
  const names: string[] = []
  for k in sortKeys(keys) { names.push(k.path) }
  const zero: u8[] = [0]
  let h: i64 = -3750763034362895579
  for n in names {
    const src = readFile("compiler/" + n)
    if src is IoError {
      die("check-filed-witnesses: cannot read compiler/\{n} (\{src.msg})", 1)
      return { hash: "", files: 0 }
    }
    h = fnvFeed(h, n.bytes())
    h = fnvFeed(h, zero)
    h = fnvFeed(h, toString(src.length).bytes())
    h = fnvFeed(h, zero)
    h = fnvFeed(h, src)
    h = fnvFeed(h, zero)
  }
  { hash: hex64(h), files: names.length }
}

// The identity `refresh-compiler.sh` recorded beside the seed, or "" when there is none.
function recordedIdentity(): string {
  const t = readTextFile(SIDECAR)
  if t is IoError { return "" }
  for raw in splitLines(univNl(t)) {
    const line = stripWs(raw)
    if line != "" && !startsWith(line, "#") {
      let e = 0
      while e < line.length && wsLen(line, e) == 0 { e = e + 1 }
      return line.slice(0, e)
    }
  }
  ""
}

// Print the seed's provenance and answer an exit code, or 0 to carry on.
function provenance(moved: i32): i32 {
  const what = "check-filed-witnesses"
  const have = sourceIdentity()
  const want = recordedIdentity()
  const n = toString(have.files)
  if want == "" {
    print(
      "seed provenance: UNKNOWN (no \{SIDECAR}) · compiler/*.vl is \{have.hash} over \{n} files",
    )
    if moved > 0 {
      print(
        "\{what}: REFUSING to report \{toString(moved)} MOVED row(s) against a seed of unknown provenance —\n  a MOVED reading is quoted with the seed's identity beside the tree's or it is\n  not a reading. Run `scripts/refresh-compiler.sh` and re-run.",
      )
      return 2
    }
    return 0
  }
  if want == have.hash {
    print(
      "seed provenance: \{want} · compiler/*.vl \{have.hash} over \{n} files — match",
    )
    return 0
  }
  print(
    "seed provenance: \{want} · compiler/*.vl \{have.hash} over \{n} files — DIFFER",
  )
  print(
    "\{what}: REFUSING — the seed was built from different `compiler/*.vl` than the ones\n  checked out, so every row would be graded against a compiler this tree does\n  not describe. Run `scripts/refresh-compiler.sh` and re-run.",
  )
  2
}

// ── the report ───────────────────────────────────────────────────────────────

function jsonRecord(g: Graded): string {
  const r = g.row
  let status = "null"
  if r.hasStatus { status = jsonStr(r.status) }
  let want = "null"
  if r.wantLabels > 0 { want = jsonStr(r.want) }
  let agrees = "false"
  if g.actual == g.declared { agrees = "true" }
  "  {\n    \"id\": \{jsonStr(r.id)},\n    \"title\": \{jsonStr(r.title)},\n    \"status\": \{status},\n    \"repro\": \{jsonStr(r.repro)},\n    \"want\": \{want},\n    \"want_labels\": \{toString(r.wantLabels)},\n    \"doc\": \{jsonStr(r.doc)},\n    \"line\": \{toString(r.line)},\n    \"declared\": \{jsonStr(g.declared)},\n    \"actual\": \{jsonStr(g.actual)},\n    \"detail\": \{jsonStr(g.detail)},\n    \"agrees\": \{agrees}\n  }"
}

function jobsFromEnv(): i32 {
  const j = getEnv("JOBS")
  if j is string {
    const n = parseI32(stripWs(j))
    if n == null {
      die("check-filed-witnesses: JOBS is not an integer: " + j, 1)
    }
    return n ?? 4
  }
  4
}

const USAGE = "usage: vl run scripts/check-filed-witnesses.vl -- [--strict] [--json OUT] [--shard K/N] <doc-or-dir>...\n       vl run scripts/check-filed-witnesses.vl -- --self-test\nRun from the checkout root; `$JOBS` rows at a time (default 4).\nExit 0 when every row behaves as filed, 1 when one MOVED, or, under --strict, cannot be\ngraded, 2 when the seed's provenance refuses the reading."

// `--shard K/N` keeps every N-th row from the K-th, `@@repeat` rows dealt first, so the N shards
// partition the rows; shard 1 alone also reports the unparsed headings.
function mainReport(
  docs: string[],
  strict: boolean,
  outJson: string,
  shardK: i32,
  shardN: i32,
): i32 {
  const all: Row[] = []
  const allDeclared: string[] = []
  const allReasons: string[] = []
  const rows: Row[] = []
  const declared: string[] = []
  const reasons: string[] = []
  const unparsed: string[] = []
  for arg in docs {
    for doc in resolve(arg) {
      const heads = unparsedRowHeads(doc)
      let h = 0
      while h < heads.length {
        unparsed.push(doc + ":" + heads[h] + "  " + cpPrefix(heads[h + 1], 110))
        h = h + 2
      }
      for r in parseDoc(doc) {
        all.push(r)
        if r.repro == "" {
          allDeclared.push("")
          allReasons.push("no Repro block")
          continue
        }
        const want = declaredOutcome(r.status)
        if want == "" {
          allDeclared.push("")
          allReasons.push("status line names no known outcome")
          continue
        }
        if r.wantLabels > 1 {
          allDeclared.push("")
          allReasons.push("carries more than one `Want:` block")
          continue
        }
        if r.wantLabels > 0 && r.want == "" {
          allDeclared.push("")
          allReasons.push("a `Want:` label with no indented block under it")
          continue
        }
        allDeclared.push(want)
        allReasons.push("")
      }
    }
  }
  // Deal the `@@repeat` rows (each several seconds) first and the rest after, each round-robin,
  // so no shard draws them all. The rule reads only the documents, so every shard computes
  // the same split and the N shards partition the rows.
  let dealt = 0
  for pass in [true, false] {
    let si = 0
    while si < all.length {
      if contains(all[si].repro, "@@repeat(") == pass {
        if dealt % shardN == shardK - 1 {
          rows.push(all[si])
          declared.push(allDeclared[si])
          reasons.push(allReasons[si])
        }
        dealt = dealt + 1
      }
      si = si + 1
    }
  }
  if shardK != 1 { unparsed.clear() }
  const srcs: string[] = []
  let k = 0
  while k < rows.length {
    if declared[k] != "" { srcs.push(rows[k].repro) }
    k = k + 1
  }
  const ran = runAll(srcs, jobsFromEnv(), true)
  const results: Graded[] = []
  const ungradable: Graded[] = []
  let wantChecked = 0
  let next = 0
  k = 0
  while k < rows.length {
    const r = rows[k]
    const want = declared[k]
    if want == "" {
      ungradable.push(
        { row: r, declared: "", actual: "", detail: "", why: reasons[k] },
      )
      k = k + 1
      continue
    }
    const out = ran[next]
    next = next + 1
    const v = grade(r.status, r.repro, r.wantLabels > 0, r.want, want, out)
    if v.got == "" {
      ungradable.push(
        { row: r, declared: "", actual: "", detail: "", why: v.why },
      )
      k = k + 1
      continue
    }
    if (
      r.wantLabels > 0
      && (v.got == "runs"
        || v.got == "silent_wrong_value"
        || v.got == "wrong_output")
    ) {
      wantChecked = wantChecked + 1
    }
    let detail = out.detail
    if v.got == "wrong_output" {
      detail = "prints "
        + cpPrefix(jsonStr(normOutput(out.stdout)), 120)
        + ", Want "
        + cpPrefix(jsonStr(normOutput(r.want)), 120)
    }
    results.push(
      { row: r, declared: want, actual: v.got, detail: detail, why: "" },
    )
    k = k + 1
  }
  const moved: Graded[] = []
  let mismatch = 0
  let w = 4
  for g in results {
    if g.actual != g.declared { moved.push(g) }
    if g.actual == "wrong_output" { mismatch = mismatch + 1 }
    if g.row.id.cpLen() > w { w = g.row.id.cpLen() }
  }
  print(
    "\{padTo("ID", w)}  \{padTo("FILED", 22)} \{padTo("TODAY", 22)} VERDICT",
  )
  for g in results {
    let verdict = "** MOVED **"
    if g.actual == g.declared { verdict = "as filed" }
    print(
      "\{padTo(g.row.id, w)}  \{padTo(g.declared, 22)} \{padTo(g.actual, 22)} \{verdict}",
    )
  }
  for g in ungradable {
    print(
      "\{padTo(g.row.id, w)}  \{padTo("-", 22)} \{padTo("-", 22)} not graded (\{g.why})",
    )
  }
  print(
    "\n\{toString(results.length)} graded · \{toString(results.length - moved.length)} as filed · \{toString(moved.length)} MOVED · \{toString(ungradable.length)} not graded · \{toString(unparsed.length)} UNPARSED",
  )
  print(
    "\{toString(wantChecked)} output-checked against Want · \{toString(mismatch)} output mismatch",
  )
  const prov = provenance(moved.length)
  if moved.length > 0 {
    print(
      "\nRows whose filed behaviour no longer reproduces — re-grade the doc:",
    )
    for g in moved {
      print(
        "  \{g.row.doc}:\{toString(g.row.line)}  \{g.row.id} — \{g.row.title}",
      )
      print(
        "      filed \{g.declared}, now \{g.actual}: \{firstLine(g.detail)}",
      )
    }
  }
  if ungradable.length > 0 && strict {
    print(
      "\nRows this cannot grade - a filed row must carry a witness the checker RUNS:",
    )
    for g in ungradable {
      print(
        "  \{g.row.doc}:\{toString(g.row.line)}  \{g.row.id} - \{g.row.title}",
      )
      print("      " + g.why)
    }
    print(
      "      fix: give it a `Repro:` block and a status line naming one of \{OUTCOMES_SORTED}.",
    )
    print(
      "      a witness that does not PARSE is prose, not a program: write the program, or — where the parse-stage refusal IS the filed outcome — say `parse error` in the status line.",
    )
    print(
      "      a defect reachable only under a change that was REFUSED is a refutation pin: file the program that must keep RUNNING, with the status `runs today and must keep running`.",
    )
    let stopped = false
    for g in ungradable {
      if endsWith(g.why, "re-run the row alone") { stopped = true }
    }
    if stopped {
      print(
        "      a row stopped by `timeout` or a signal measured the box, not the row: it is graded nothing, never a filed outcome. Re-run it on a quiet box, or raise $WITNESS_TIMEOUT.",
      )
    }
  }
  if unparsed.length > 0 {
    print(
      "\nRow headings this parser did NOT recognise - they are in no column above:",
    )
    for u in unparsed { print("  " + u) }
    print(
      "      fix: widen `SEC`'s id pattern to admit the suffix, or rename the row.",
    )
  }
  if outJson != "" {
    const recs: string[] = []
    for g in results { recs.push(jsonRecord(g)) }
    let body = "[]"
    if recs.length > 0 { body = "[\n" + join(recs, ",\n") + "\n]" }
    writeText(outJson, body)
    print("\nwrote " + outJson)
  }
  if prov != 0 { return prov }
  if (
    moved.length > 0
    || unparsed.length > 0
    || (ungradable.length > 0 && strict)
  ) {
    return 1
  }
  0
}

// ── --self-test: the outcome vocabulary fires on specimens predicted in source ──────

const WANT_PROG = "print(4)\nprint(\"x\")\n"

function selfTest(): i32 {
  print(
    "outcome-vocabulary self-test (prediction stated in source, before the run)",
  )
  const wants = [
    "runs", "check_reject", "trap_loads", "runs", "runs", "witness_unparsed",
  ]
  const srcs = [
    "print(6 * 7)\n", "const x: i32 = \"nope\"\nprint(x)\n",
    "const xs: i32[] = [1, 2]\nprint(xs.length)\nprint(xs[9])\n",
    "// file: a.vl\nexport function six(): i32 { return 6 }\n// file: main.vl\nimport { six } from \"./a\"\nprint(six() * 7)\n",
    "const xs: i32[] = [1]\nconst s = \"@@repeat(40, \"ab\")@@\"\nprint(xs[s.length - 80])\n",
    "The classifier answers only for the distinct-backing kinds, and the caller's\nbinding stays non-null: strictly worse than the refusal it replaced.\n",
  ]
  // Want specimens: declared outcome, repro, Want block ("-" for none), predicted grade.
  const wd = [
    "runs", "runs", "runs", "silent_wrong_value", "silent_wrong_value",
    "silent_wrong_value", "silent_wrong_value", "runs",
  ]
  const ws = [
    WANT_PROG,
    WANT_PROG,
    WANT_PROG,
    WANT_PROG,
    WANT_PROG,
    "print(4)\n// PRINTS 4\n",
    "print(4)\n// PRINTS 3\n",
    WANT_PROG,
  ]
  const ww = [
    "4\nx\n", "4\ny\n", "-", "5\nx\n", "4\nx\n", "5\n", "5\n", "4  \nx\n\n",
  ]
  const wp = [
    "runs", "wrong_output", "runs", "silent_wrong_value", "runs",
    "silent_wrong_value", "wrong_output", "runs",
  ]
  const all: string[] = []
  for s in srcs { all.push(s) }
  for s in ws {
    let seen = false
    for a in all {
      if a == s { seen = true }
    }
    if !seen { all.push(s) }
  }
  const ran = runAll(all, 1, false)
  let bad = 0
  let k = 0
  while k < wants.length {
    const got = ran[k].outcome
    const ok = got == wants[k]
    if !ok { bad = bad + 1 }
    let mark = "** WRONG **"
    if ok { mark = "ok" }
    print("  want \{padTo(wants[k], 20)} got \{padTo(got, 20)} \{mark}")
    if !ok { print("      " + firstLine(ran[k].detail)) }
    k = k + 1
  }
  const n = wants.length + wd.length
  print("`Want:` grading (declared, Want -> predicted)")
  k = 0
  while k < wd.length {
    let at = 0
    while all[at] != ws[k] { at = at + 1 }
    const hasWant = ww[k] != "-"
    const v = grade("", ws[k], hasWant, ww[k], wd[k], ran[at])
    let graded = v.got
    if graded == "" { graded = v.why }
    const ok = v.got == wp[k]
    if !ok { bad = bad + 1 }
    let shown = "null"
    if hasWant { shown = jsonStr(ww[k]) }
    let mark = "** WRONG **"
    if ok { mark = "ok" }
    print(
      "  \{padTo(wd[k], 20)} \{padTo(shown, 16)} want \{padTo(wp[k], 20)} got \{padTo(graded, 20)} \{mark}",
    )
    k = k + 1
  }
  print(
    "\{toString(n)} specimens · \{toString(n - bad)} routed correctly · \{toString(bad)} wrong",
  )
  if bad > 0 { return 1 }
  0
}

// ── the command ─────────────────────────────────────────────────────────────────

function main(args: string[]): i32 {
  if args.length > 0 && args[0] == "--grade-chunk" {
    let k = 1
    while k < args.length {
      gradeChunk(splitLines(readText(args[k])))
      k = k + 1
    }
    return 0
  }
  let outJson = ""
  let strict = false
  let shardK = 1
  let shardN = 1
  const docs: string[] = []
  let i = 0
  while i < args.length {
    const a = args[i]
    if a == "--json" {
      if i + 1 >= args.length {
        die("check-filed-witnesses: --json needs a path", 2)
      }
      outJson = args[i + 1]
      i = i + 2
      continue
    }
    if a == "--shard" {
      let k = 0
      let n = 0
      if i + 1 < args.length {
        const kn = args[i + 1].split("/")
        if kn.length == 2 {
          k = parseI32(kn[0]) ?? 0
          n = parseI32(kn[1]) ?? 0
        }
      }
      if !(n >= 1 && k >= 1 && k <= n) {
        die("check-filed-witnesses: --shard needs K/N with 1 <= K <= N", 2)
      }
      shardK = k
      shardN = n
      i = i + 2
      continue
    }
    if a == "--strict" { strict = true }
    else if a == "--self-test" { return selfTest() }
    else { docs.push(a) }
    i = i + 1
  }
  if docs.length == 0 {
    print(USAGE)
    return 2
  }
  mainReport(docs, strict, outJson, shardK, shardN)
}

const argv = programArgs()
if argv is Utf8Error {
  die("check-filed-witnesses: an argument is not UTF-8: " + argv.msg, 2)
} else {
  exit(main(argv))
}
