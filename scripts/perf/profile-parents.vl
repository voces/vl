// Whose loop is it? Rank the immediate PARENT frame of every sample whose leaf is FUNC, and
// print FUNC's own self share.
//
//     vl run scripts/perf/profile-parents.vl -- <profile.json> [func] [top=20]
//
// `__str_eq__` at the top of a profile is a symptom, not a site: it is the name-keyed
// registries doing linear lookups, and this attributes those samples to the registry that
// asked. With no FUNC it prints every leaf's self share instead, so a function too small for
// `scripts/profile-rank.vl`'s top-N can still be looked up.

import { exit } from "std:process"
import { programArgs } from "std:args"
import { Utf8Error } from "std:utf8"
import { padLeft, parseI32, toString } from "std:fmt"
import { die, pyFixed } from "../lib/common"
import { loadProfile, nodeName, rankDesc } from "../lib/profile"

const USAGE = "usage: vl run scripts/perf/profile-parents.vl -- <profile.json> [func] [top]"

// A name-keyed counter that remembers first-insertion order, as `collections.Counter` does.
type Tally = { ix: Map<string, i32>, names: string[], counts: f64[] }

function tally(): Tally {
  const ix: Map<string, i32> = Map()
  { ix: ix, names: [], counts: [] }
}

function bump(t: Tally, name: string) {
  const at = t.ix[name]
  if at != null {
    t.counts[at] = t.counts[at] + 1.0
  } else {
    t.ix[name] = t.names.length
    t.names.push(name)
    t.counts.push(1.0)
  }
}

// `t`'s indices as `Counter.most_common(top)` orders them.
function mostCommon(t: Tally, top: i32): i32[] {
  const ix: i32[] = []
  let i = 0
  while i < t.names.length {
    ix.push(i)
    i = i + 1
  }
  const ranked = rankDesc(ix, t.counts)
  if ranked.length > top { return ranked.slice(0, top) }
  ranked
}

function main(argv: string[]): i32 {
  if argv.length < 1 {
    print(USAGE)
    return 2
  }
  const p = loadProfile(argv[0], "profile-parents")
  const func = if argv.length > 1 { argv[1] } else { "" }
  let top = 20
  if argv.length > 2 {
    const t = parseI32(argv[2])
    if t == null {
      die("profile-parents: top is not an integer: " + argv[2], 2)
    }
    top = t ?? 20
  }
  const samples: i32[] = []
  for s in p.stacks {
    if s >= 0 { samples.push(s) }
  }
  const total = samples.length as f64
  if func == "" {
    const selfT = tally()
    for s in samples { bump(selfT, nodeName(p, s)) }
    print("\{toString(samples.length)} samples")
    for k in mostCommon(selfT, top) {
      print(
        "\{padLeft(pyFixed(100.0 * selfT.counts[k] / total, 2), 7, " ")}  \{selfT.names[k]}",
      )
    }
    return 0
  }
  if samples.length == 0 {
    die("profile-parents: the profile has no samples", 1)
  }
  const par = tally()
  let hits = 0
  for s in samples {
    if nodeName(p, s) == func {
      hits = hits + 1
      const up = p.prefix[s]
      bump(par, if up >= 0 { nodeName(p, up) } else { "<root>" })
    }
  }
  const self = pyFixed(100.0 * (hits as f64) / total, 2)
  print(
    "\{toString(samples.length)} samples; \{func} is the leaf of \{toString(hits)} (\{self}% self)",
  )
  print(" of-total  of-func  immediate caller")
  for k in mostCommon(par, top) {
    const ofTotal = padLeft(pyFixed(100.0 * par.counts[k] / total, 2), 9, " ")
    const ofFunc = padLeft(
      pyFixed(100.0 * par.counts[k] / (hits as f64), 1),
      8,
      " ",
    )
    print("\{ofTotal} \{ofFunc}  \{par.names[k]}")
  }
  0
}

const argv = programArgs()
if argv is Utf8Error {
  die("profile-parents: an argument is not UTF-8: " + argv.msg, 2)
} else {
  exit(main(argv))
}
