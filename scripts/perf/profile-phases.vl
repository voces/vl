// Attribute a `VL_PROFILE_GUEST` profile to the module pipeline's PHASES.
//
//     scripts/perf/guest-profile.sh /tmp/p build compiler/entry.vl
//     vl run scripts/perf/profile-phases.vl -- /tmp/p/entry.json
//
// `scripts/profile-rank.vl` ranks FUNCTIONS; this ranks the driver's stages. Each sample is
// walked from the ROOT down and charged to the first frame naming a phase entry point, so a
// phase's number is inclusive of everything it calls and the phases partition the run. That
// separates the per-module half of a check (scan, lex, parse, rename) from the merged half
// (`checkProgram` over every module's statements at once). Profile the command you mean:
// a `vl check` profile reports the check's own phases, `lintGraph` included.

import { exit } from "std:process"
import { programArgs } from "std:args"
import { Utf8Error } from "std:utf8"
import { includes } from "std:array"
import { parseF64, toString } from "std:fmt"
import { die, isDigit, pyFixed } from "../lib/common"
import { Json } from "std:json"
import { Profile, arr, field, loadProfile, nodeName } from "../lib/profile"

const USAGE = "usage: vl run scripts/perf/profile-phases.vl -- <profile.json> [--fuel <n>] [--weighted]"

// Root-down, first match wins, except that a CONTAINER phase yields to a phase named deeper under
// it: the stack decides, not the order here.
const PHASES: string[] = [
  "stage: modScan (import/export scan)",
  "stage: modCommit / modSrcLoad (host fetch)", "1 order+validate (modVisit)",
  "2 lex per module (vcLoadToksMod)", "2 parse per module (parseProgram)",
  "2b dup / builtin-decl screens", "3+4 rename + rewrite per module",
  "4b/4c export alias tables", "5 csPreMintLocs (MERGED)",
  "5 checkProgram (MERGED)", "6 emitProgram, other (build only)",
  "7 lintGraph (check only)", "5e elabPrepare (build only)",
  "6a emit passes (runEmitPasses)", "6b code payload (buildCodePayload)",
  "6c emitModule, other",
]

// The entry points of `PHASES[i]`, at the same index.
const ENTRIES: string[][] = [
  ["modScan"],
  [
    "modCommit", "modCommitStr", "modSrcLoad", "modKeyLoad",
  ],
  ["modVisit"],
  ["vcLoadToksMod", "vcLoadToksEntry", "vcLoadToks"],
  ["parseProgram"],
  ["modCheckDupBindings", "modCheckReservedDecls"],
  [
    "modCollectSelfFns", "modBuildRename", "modBankUfcsScope",
    "ufcsModBoundAdd", "modRwStmt", "modRwDeclBase",
  ],
  ["modMergedTargetOf"],
  ["csPreMintLocs"],
  ["checkProgram", "checkProgramResumed"],
  ["emitProgram"],
  ["lintGraph", "lintSrc"],
  ["elabPrepare"],
  ["runEmitPasses"],
  ["buildCodePayload"],
  ["emitModule"],
]

// The phases a deeper named phase overrides: `emitProgram` and `emitModule` hold the split ones.
const CONTAINERS: i32[] = [10, 15]
// The phases only a build reaches; the check side is every other sample.
const BUILD_ONLY: i32[] = [10, 12, 13, 14, 15]

const UNCLAIMED = "(outside every named phase)"

// `name` without the `$mN` suffix the module rename gave it, nor the `@file:line` a `--names`
// seed appends after that.
function baseName(name: string): string {
  let i = 0
  while i + 1 < name.length {
    if name[i] == 36 && name[i + 1] == 109 {
      let j = i + 2
      while j < name.length && isDigit(name[j]) { j = j + 1 }
      if j > i + 2 && (j == name.length || name[j] == 64) {
        return name.slice(0, i)
      }
    }
    i = i + 1
  }
  return name
}

// The phase index of each stack node, -1 for none: its root-most frame naming an entry point.
function phases(p: Profile): i32[] {
  const byName: Map<string, i32> = Map()
  let k = 0
  while k < ENTRIES.length {
    for n in ENTRIES[k] { byName[n] = k }
    k = k + 1
  }
  // -2 is not yet computed.
  const memo: i32[] = []
  for _ in p.stFrame { memo.push(-2) }
  let s = 0
  while s < memo.length {
    const chain: i32[] = []
    let cur = s
    while cur >= 0 && memo[cur] == -2 {
      chain.push(cur)
      cur = p.prefix[cur]
    }
    let acc = if cur >= 0 { memo[cur] } else { -1 }
    let c = chain.length - 1
    while c >= 0 {
      const node = chain[c]
      if acc < 0 || CONTAINERS.includes(acc) {
        const named = byName[baseName(nodeName(p, node))] ?? -1
        if named >= 0 { acc = named }
      }
      memo[node] = acc
      c = c - 1
    }
    s = s + 1
  }
  return memo
}

function main(argv: string[]): i32 {
  if argv.length < 1 {
    print(USAGE)
    return 2
  }
  let fuel = -1.0
  let weighted = false
  let k = 1
  while k < argv.length {
    if argv[k] == "--fuel" && k + 1 < argv.length {
      fuel = parseF64(argv[k + 1]) ?? -1.0
      k = k + 2
    } else if argv[k] == "--weighted" {
      weighted = true
      k = k + 1
    } else {
      print(USAGE)
      return 2
    }
  }
  const p = loadProfile(argv[0], "profile-phases")
  const phaseOf = phases(p)
  // `--weighted`: each sample weighs its `threadCPUDelta`, the fuel since the sample before when
  // the profile was taken under `VL_PROFILE_GUEST_FUEL=1`.
  const weights: Json[] = []
  if weighted {
    const col = field(p.samples, "threadCPUDelta")
    if col == null {
      weighted = false
    } else {
      for w in arr(col, "profile-phases", "threadCPUDelta") { weights.push(w) }
    }
  }
  // One slot per phase, then the unclaimed one; samples and weight.
  const counts: i32[] = []
  const wsum: f64[] = []
  for _ in PHASES {
    counts.push(0)
    wsum.push(0.0)
  }
  counts.push(0)
  wsum.push(0.0)
  let total = 0
  let wtotal = 0.0
  let i = 0
  while i < p.stacks.length {
    const s = p.stacks[i]
    if s >= 0 {
      total = total + 1
      const ph = phaseOf[s]
      const at = if ph >= 0 { ph } else { PHASES.length }
      counts[at] = counts[at] + 1
      if weighted && i < weights.length {
        const x = weights[i]
        const w = if x is f64 { x } else { 0.0 }
        wsum[at] = wsum[at] + w
        wtotal = wtotal + w
      }
    }
    i = i + 1
  }
  if total == 0 {
    print("no samples")
    return 1
  }
  // A weight total that is not the run's fuel came from a host that ignores
  // `VL_PROFILE_GUEST_FUEL`: its weights are time, so the sample shares stand in.
  const byWeight = weighted
    && wtotal > 0.0
    && (fuel < 0.0 || (wtotal > 0.95 * fuel && wtotal < 1.05 * fuel))
  if weighted && !byWeight {
    print(
      "the profile's weights are not fuel (a host without VL_PROFILE_GUEST_FUEL); fuel below is by sample share",
    )
  }
  let build = 0
  for b in BUILD_ONLY { build = build + counts[b] }
  const check = total - build
  print(
    "samples \{toString(total)}; check side (every phase but the build-only ones) \{toString(check)}",
  )
  const fuelCol = byWeight || fuel >= 0.0
  if fuelCol {
    const how = if byWeight { "fuel (by sample weight)" } else { "fuel (by sample share)" }
    print("| phase | samples | % of run | % of the check side | \{how} |")
    print("| --- | ---: | ---: | ---: | ---: |")
  } else {
    print("| phase | samples | % of run | % of the check side |")
    print("| --- | ---: | ---: | ---: |")
  }
  let j = 0
  while j < counts.length {
    const n = counts[j]
    if n != 0 {
      const label = if j < PHASES.length { PHASES[j] } else { UNCLAIMED }
      const side = if BUILD_ONLY.includes(j) || check == 0 { "—" } else { pyFixed(100.0 * (n as f64) / (check as f64), 1) + "%" }
      const run = pyFixed(100.0 * (n as f64) / (total as f64), 2)
      if fuelCol {
        const f = if byWeight { wsum[j] } else { fuel * (n as f64) / (total as f64) }
        const share = pyFixed(f / 1000000000.0, 2) + "G"
        print("| \{label} | \{toString(n)} | \{run}% | \{side} | \{share} |")
      } else {
        print("| \{label} | \{toString(n)} | \{run}% | \{side} |")
      }
    }
    j = j + 1
  }
  return 0
}

const argv = programArgs()
if argv is Utf8Error {
  die("profile-phases: an argument is not UTF-8: " + argv.msg, 2)
} else {
  exit(main(argv))
}
