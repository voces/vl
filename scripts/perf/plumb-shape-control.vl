// The plumb-shape ratchet's quiet-box control: a fixed CPU workload no compiler change
// can move, of map, string and sort traffic. `scripts/plumb-shape-cost.vl` builds it once
// and times a run before each build it grades. It imports nothing, so it builds at once.

function hexOf(v: i64): string {
  const digits = "0123456789abcdef"
  if v == 0 { return "0" }
  let out = ""
  let x = v
  while x > 0 {
    const d = (x & 15) as! i32
    out = digits.slice(d, d + 1) + out
    x = x >> 4
  }
  out
}

function sortStrings(xs: string[]): string[] {
  if xs.length <= 1 { return xs }
  const mid = xs.length / 2
  const a = sortStrings(xs.slice(0, mid))
  const b = sortStrings(xs.slice(mid, xs.length))
  const out: string[] = []
  let i = 0
  let j = 0
  while i < a.length || j < b.length {
    if j >= b.length || (i < a.length && !(b[j] < a[i])) {
      out.push(a[i])
      i = i + 1
    } else {
      out.push(b[j])
      j = j + 1
    }
  }
  out
}

// Map, string and sort traffic, the shape of the Python's control.
function controlWork(): i32 {
  let acc = 0
  let rnd = 0
  while rnd < 3 {
    const d: Map<string, i32> = Map()
    let i = 0
    while i < 120000 {
      const k = "k"
        + hexOf(((i as! i64) * 2654435761 + (rnd as! i64)) & 0xFFFFF)
      d[k] = (d[k] ?? 0) + i
      i = i + 1
    }
    const keys: string[] = []
    for k in d { keys.push(k) }
    acc = acc + sortStrings(keys).length
    rnd = rnd + 1
  }
  acc
}

print(controlWork())
