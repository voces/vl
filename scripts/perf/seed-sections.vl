// Section sizes of a wasm module, largest first, with each one's share of the total.
//
//     vl run scripts/perf/seed-sections.vl -- [seed.wasm]
//
// The seed is JIT/deserialize input for every `vl` process in ci-native, so its size is
// a per-process cost. A custom section is named `custom:<name>`. The path is relative to
// the working directory, which is the checkout root when `seed-sections.sh` runs this.

import { IoError, readFile } from "std:fs"
import { programArgs } from "std:args"
import { Utf8Error, decodeUtf8Lossy } from "std:utf8"
import { padLeft, toFixed, toString } from "std:fmt"
import { exit } from "std:process"
import { sorted } from "std:array"

type Section = { size: i32, name: string }

// The standard section ids; an id outside this list prints as its number.
function sectionName(id: i32): string {
  if id == 0 { return "custom" }
  if id == 1 { return "type" }
  if id == 2 { return "import" }
  if id == 3 { return "function" }
  if id == 4 { return "table" }
  if id == 5 { return "memory" }
  if id == 6 { return "global" }
  if id == 7 { return "export" }
  if id == 8 { return "start" }
  if id == 9 { return "elem" }
  if id == 10 { return "code" }
  if id == 11 { return "data" }
  if id == 12 { return "datacount" }
  if id == 13 { return "tag" }
  toString(id)
}

// The LEB128 unsigned integer starting at `at`: its value and the offset after it.
function uleb(b: readonly u8[], at: i32): i32[] {
  let n = 0
  let shift = 0
  let i = at
  while true {
    const c = b[i] as! i32
    i = i + 1
    n = n | ((c & 0x7f) << shift)
    shift = shift + 7
    if (c & 0x80) == 0 { return [n, i] }
  }
  [n, i]
}

// Largest first; equal sizes order by name descending, as a reverse sort of the pairs does.
function bigger(a: Section, b: Section): boolean {
  if a.size != b.size { return a.size > b.size }
  a.name > b.name
}

// "  100.0%" style share, one decimal, right-aligned to five columns.
function share(size: i32, total: i32): string {
  padLeft(toFixed(100.0 * (size as! f64) / (total as! f64), 1), 5, " ")
}

function row(size: i32, total: i32, name: string): string {
  padLeft(toString(size), 10, " ") + "  " + share(size, total) + "%  " + name
}

function main(path: string) {
  const b = readFile(path)
  if b is IoError {
    print("seed-sections: cannot read \{path} (\{b.msg})")
    exit(1)
    return 0
  }
  const rows: Section[] = []
  let i = 8
  while i < b.length {
    const id = b[i] as! i32
    const sz = uleb(b, i + 1)
    let name = sectionName(id)
    if id == 0 {
      const nl = uleb(b, sz[1])
      const text = decodeUtf8Lossy(b.slice(nl[1], nl[1] + nl[0]))
      name = "custom:" + text
    }
    rows.push({ size: sz[0], name: name })
    i = sz[1] + sz[0]
  }
  let total = 0
  for r in rows { total = total + r.size }
  for r in sorted(rows, bigger) { print(row(r.size, total, r.name)) }
  print(row(total, total, "TOTAL (sections)"))
  0
}

const argv = programArgs()
if argv is Utf8Error {
  print("seed-sections: an argument is not UTF-8: " + argv.msg)
  exit(2)
} else if argv.length > 0 {
  main(argv[0])
} else {
  main("build/vl-compiler.wasm")
}
